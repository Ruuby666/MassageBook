rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reservations hold client PII (name, phone, address).
    // Only the authenticated therapist can read them. All writes go
    // through the createReservation Cloud Function (Admin SDK bypasses
    // these rules), so both the public web form and the therapist's
    // manual-entry flow share one place that enforces fixed durations
    // and the 30-minute buffer between bookings.
    match /reservations/{reservationId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Availability blocks: no PII, just date/time ranges — public read so
    // the client web form can hide blocked days before submitting (the
    // Cloud Function is the actual enforcement; this is only the UX hint).
    // Only the therapist can create/edit them from the app.
    match /blocks/{blockId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Massage catalog: public menu info (name/description/duration/price),
    // no PII, so anyone can read it — the client web form needs this to
    // show clients their options. Only the therapist can manage entries.
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
