{
  "name": "massagebook",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:rules": "firebase emulators:exec --only firestore --project demo-massagebook \"node tests/firestore-rules.test.mjs\"",
    "test:scheduled": "firebase emulators:exec --only firestore --project demo-massagebook \"node tests/scheduled-functions.test.cjs\"",
    "test:booking": "firebase emulators:exec --only firestore --project demo-massagebook \"node tests/booking-concurrency.test.cjs\"",
    "test:web": "firebase emulators:exec --only firestore,functions --project demo-massagebook \"node tests/web-e2e.test.mjs\"",
    "lint": "eslint .",
    "use:masajista": "node scripts/use-project.js masajista",
    "use:mio": "node scripts/use-project.js mio"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/material-top-tabs": "^7.8.1",
    "@react-navigation/native": "^7.3.11",
    "expo": "~54.0.38",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.33.1",
    "react-native-pager-view": "6.9.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "firebase-tools": "^14.27.0",
    "globals": "^14.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "puppeteer-core": "^23.11.1",
    "test-renderer": "1.3.1"
  },
  "overrides": {
    "test-renderer": "1.3.1"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js",
      "./node_modules/@react-native-community/datetimepicker/jest/index.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/functions/"
    ]
  },
  "private": true
}
