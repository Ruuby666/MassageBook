{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "terapeuta": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "terapeuta" }
    },
    "mio": {
      "extends": "base",
      "environment": "preview",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "mio" }
    }
  }
}
