# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
#
# Gmail address the reminder emails are sent from.
GMAIL_USER=

# Gmail "app password" (NOT your normal Gmail password), 16 characters,
# generated at myaccount.google.com -> Security -> 2-Step Verification ->
# App passwords. Requires 2-Step Verification to be enabled on the account.
GMAIL_APP_PASSWORD=
